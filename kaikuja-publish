           'mastodon': mastodon_post, 'bluesky': bluesky_post, 'linkedin': linkedin_post,
           'facebook-sivu': facebook_page_post, 'instagram': instagram_post, 'threads': threads_post,
           'facebook-oma': facebook_own}
# klipit: ei blogia eikä Podbeania. Instagram ennen Threadsia (Threads käyttää Reelin videota).
CLIP = {'youtube': youtube_clip, 'instagram': instagram_reel,
        'threads': lambda d: threads_post(d, video=True), 'facebook-sivu': facebook_page_reel,
        'mastodon': lambda d: mastodon_post(d, video=True), 'bluesky': lambda d: bluesky_post(d, video=True),
        'linkedin': lambda d: linkedin_post(d, video=True)}


def main():
    global DRY
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--dry-run', action='store_true')
    ap.add_argument('--only', help='pilkulla erotettu lista vaiheita')
    ap.add_argument('--schedule', help='ajoita klippi myöhemmäksi (muoto: YYYY-MM-DD HH:MM)', metavar='AIKA')
    ap.add_argument('cmd', choices=['prepare', 'publish', 'clip', 'check', 'auth', 'publish-scheduled'])
    ap.add_argument('arg', nargs='?')
    a = ap.parse_args()
    DRY = a.dry_run
    load_env()
    if a.cmd == 'check':
        return check_all()
    if a.cmd == 'auth':
        return {'youtube': auth_youtube, 'linkedin': auth_linkedin}[a.arg]()
    if a.cmd == 'publish-scheduled':
        return publish_scheduled()
    doc = Doc(a.arg)
    steps = {'prepare': PREPARE, 'publish': PUBLISH, 'clip': CLIP}[a.cmd]
    if a.cmd == 'clip':
        w, h, dur = video_info(doc.file('video'))
        log(f'Klippi: {doc.get("video")} — {w}×{h}, {dur:.0f} s, {mb(doc.file("video"))}')
        if h <= w or dur > 180:
            log('  HUOM: YouTube Shorts vaatii pystyvideon ja enintään 3 min (muuten tavallinen video)')
        if a.schedule:
            try:
                scheduled_dt = datetime.fromisoformat(a.schedule.replace(' ', 'T'))
                if scheduled_dt <= datetime.now():
                    raise SystemExit(f'Aika on jo mennyt: {a.schedule}')
                schedule_clip(doc, scheduled_dt)
                return
            except ValueError:
                raise SystemExit(f'Väärä aikamuoto: {a.schedule}; käytä YYYY-MM-DD HH:MM')
    only = [s.strip() for s in a.only.split(',')] if a.only else list(steps)
    for name in only:
        if name not in steps:
            raise SystemExit(f'Tuntematon vaihe {name}; vaihtoehdot: {", ".join(steps)}')
    for name, fn in steps.items():
        if name in only:
            fn(doc)


if __name__ == '__main__':
    main()
