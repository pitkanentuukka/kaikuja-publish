def bsky_facets(text):
    b = text.encode('utf-8')
    facets = []
    for m in re.finditer(rb'https?://[^\s]+', b):
        url = m.group(0).rstrip(b'.,)!?')
        facets.append({'index': {'byteStart': m.start(), 'byteEnd': m.start() + len(url)},
                       'features': [{'$type': 'app.bsky.richtext.facet#link', 'uri': url.decode()}]})
    for m in re.finditer(rb'(?:^|\s)(#[^\s#.,!?:;]+)', b):
        tag = m.group(1)
        facets.append({'index': {'byteStart': m.start(1), 'byteEnd': m.end(1)},
                       'features': [{'$type': 'app.bsky.richtext.facet#tag', 'tag': tag[1:].decode()}]})
    return facets


BSKY_VIDEO = 'https://video.bsky.app/xrpc'


def bsky_video_blob(pds, s, path):
    """Video Blueskyn videopalvelun kautta: palvelutunnus PDS:ltä, lataus, odotus kunnes käsitelty."""
    h = {'Authorization': f'Bearer {s["accessJwt"]}'}
    did_doc = s.get('didDoc') or check(requests.get(f'https://plc.directory/{s["did"]}'), 'Bluesky DID').json()
    endpoint = next(x['serviceEndpoint'] for x in did_doc['service'] if x['id'].endswith('#atproto_pds'))
    sa = check(requests.get(f'{pds}/xrpc/com.atproto.server.getServiceAuth', headers=h, params={
        'aud': 'did:web:' + urllib.parse.urlparse(endpoint).hostname,
        'lxm': 'com.atproto.repo.uploadBlob', 'exp': int(time.time()) + 1800}), 'Bluesky service auth').json()['token']
    log(f'Bluesky: ladataan {path.name} ({mb(path)})…')
    with open(path, 'rb') as f:
        r = requests.post(f'{BSKY_VIDEO}/app.bsky.video.uploadVideo', params={'did': s['did'], 'name': path.name},
                          headers={'Authorization': f'Bearer {sa}', 'Content-Type': 'video/mp4'}, data=f)
    if r.status_code != 409:  # 409 = sama video jo ladattu, vastauksessa silti jobId
        check(r, 'Bluesky video upload')
    job = r.json()
    job = job.get('jobStatus', job)
    if job.get('blob'):
        return job['blob']

    def done():
        st = check(requests.get(f'{BSKY_VIDEO}/app.bsky.video.getJobStatus', params={'jobId': job['jobId']}),
                   'Bluesky video status').json()['jobStatus']
        if st['state'] == 'JOB_STATE_FAILED':
            raise SystemExit(f'Bluesky-videon käsittely epäonnistui: {st.get("error")} {st.get("message")}')
        return st.get('blob') if st['state'] == 'JOB_STATE_COMPLETED' else None
    return poll(done, 'Bluesky-videon käsittely')


