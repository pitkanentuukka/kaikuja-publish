# ── apurit ──────────────────────────────────────────────────────────────────

def load_env():
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text().splitlines():
            m = re.match(r'\s*(?:export\s+)?([A-Z_][A-Z0-9_]*)=(.*)$', line)
            if m and m.group(1) not in os.environ:
                os.environ[m.group(1)] = m.group(2).strip().strip('"\'')


def env(name, required=True):
    v = os.environ.get(name, '')
    if required and not v:
        raise SystemExit(f'Puuttuu {name} tiedostosta {ENV_FILE}')
    return v


def tokens():
    return json.loads(TOKENS.read_text()) if TOKENS.exists() else {}


def save_tokens(t):
    TOKENS.parent.mkdir(parents=True, exist_ok=True)
    TOKENS.write_text(json.dumps(t, indent=2))
    TOKENS.chmod(0o600)


def load_scheduled():
    return json.loads(SCHEDULED.read_text()) if SCHEDULED.exists() else {}


def save_scheduled(s):
    SCHEDULED.parent.mkdir(parents=True, exist_ok=True)
    SCHEDULED.write_text(json.dumps(s, indent=2, default=str))
    SCHEDULED.chmod(0o600)


def schedule_clip(doc, scheduled_dt):
    """Tallenna klippi myöhemmäksi julkaisuksi."""
    s = load_scheduled()
    clip_id = f"{scheduled_dt.isoformat()}_{doc.get('jakso')}_{secrets.token_hex(4)}"
    s[clip_id] = {
        'klippi_path': str(doc.path),
        'scheduled_at': scheduled_dt.isoformat(),
        'jakso': doc.get('jakso'),
    }
    save_scheduled(s)
    log(f'Klippi on ajoitettu {scheduled_dt.isoformat()}')
    return clip_id


def publish_scheduled():
    """Julkaise ajoituksensa erääntyneet klipit."""
    s = load_scheduled()
    if not s:
        log('Ei ajoitettuja klippejä.')
        return
    now = datetime.now(timezone.utc)
    to_publish = []
    remaining = {}

    for clip_id, info in s.items():
        scheduled_dt = datetime.fromisoformat(info['scheduled_at'])
        if scheduled_dt <= now:
            to_publish.append((clip_id, info))
        else:
            remaining[clip_id] = info

    if not to_publish:
        soonest = min(s.items(), key=lambda x: x[1]['scheduled_at'])
        dt = soonest[1]['scheduled_at']
        log(f'Seuraava klippi ajoitettu {dt}')
        return

    for clip_id, info in to_publish:
        log(f'Julkaistaan ajoitettu klippi {clip_id}…')
        doc = Doc(info['klippi_path'])
        only = [s.strip() for s in sys.argv[2:]] if len(sys.argv) > 2 else list(CLIP)
        for name, fn in CLIP.items():
            if name in only:
                fn(doc)
        log(f'Klippi julkaistu: {clip_id}')

    save_scheduled(remaining)
    if remaining:
        soonest = min(remaining.items(), key=lambda x: x[1]['scheduled_at'])
        log(f'Seuraava ajoitettu klippi {soonest[0]} erääntyi {soonest[1]["scheduled_at"]}')


def log(msg):
    print(msg, flush=True)


def check(r, what):
    if r.status_code >= 300:
        raise SystemExit(f'{what} epäonnistui: HTTP {r.status_code}\n{r.text[:2000]}')
    return r


class Doc:
    """Julkaisu.md: frontmatter (key: value) + '## avain' -osiot."""

    def __init__(self, path):
        self.path = Path(path)
        text = self.path.read_text()
        m = re.match(r'^---\n(.*?)\n---\n(.*)$', text, re.S)
        if not m:
            raise SystemExit(f'{path}: frontmatter puuttuu')
        self.fm_lines = m.group(1).splitlines()
        self.body = m.group(2)
        self.sections = {}
        for sm in re.finditer(r'^## (\S+)[^\n]*\n(.*?)(?=^## |\Z)', self.body, re.S | re.M):
            self.sections[sm.group(1).lower()] = sm.group(2).strip()

    def get(self, key, default=''):
        for line in self.fm_lines:
            k, _, v = line.partition(':')
            if k.strip() == key:
                return v.strip().strip('"')
        return default

    def set(self, key, value):
        if DRY:
            log(f'  [dry-run] frontmatter {key}: {value}')
            return
        new = f'{key}: "{value}"' if re.search(r'[:#]', str(value)) else f'{key}: {value}'
        for i, line in enumerate(self.fm_lines):
            if line.partition(':')[0].strip() == key:
                self.fm_lines[i] = new
                break
        else:
            self.fm_lines.append(new)
        self.path.write_text('---\n' + '\n'.join(self.fm_lines) + '\n---\n' + self.body)

    def section(self, key, required=True):
        v = self.sections.get(key, '')
        if required and not v:
            raise SystemExit(f'Julkaisu.md: osio "## {key}" puuttuu tai on tyhjä')
        # HTML-kommentit (ohjeet/merkkimäärät) pois
        v = re.sub(r'<!--.*?-->', '', v, flags=re.S)
        return '\n'.join(line.rstrip() for line in v.splitlines()).strip()

    def fill(self, text, strict=True):
        """Korvaa {youtube} {podbean} {blogi} {jakso} -paikkamerkit. strict=False jättää puuttuvat ennalleen."""
        for k, fm in (('youtube', 'youtube_url'), ('podbean', 'podbean_url'), ('blogi', 'wp_url'),
                      ('jakso', 'jakso_url')):
            if '{' + k + '}' in text:
                url = self.get(fm)
                if not url:
                    if DRY:
                        url = f'https://example.invalid/{k}'
                    elif not strict:
                        continue
                    else:
                        raise SystemExit(f'Paikkamerkki {{{k}}} käytössä mutta {fm} puuttuu — aja ensin prepare/publish')
                text = text.replace('{' + k + '}', url)
        return text

    def file(self, key):
        p = Path(os.path.expanduser(self.get(key)))
        if not p.is_file():
            raise SystemExit(f'Julkaisu.md: {key} ei osoita tiedostoon: {p}')
        return p


def video_info(path):
    """(leveys, korkeus, kesto sekunteina) ffprobella."""
    r = subprocess.run(['ffprobe', '-v', 'error', '-select_streams', 'v:0', '-show_entries',
                        'stream=width,height:format=duration', '-of', 'json', str(path)],
                       capture_output=True, text=True, check=True)
    d = json.loads(r.stdout)
    return d['streams'][0]['width'], d['streams'][0]['height'], float(d['format']['duration'])


def poll(fn, what, timeout=900, every=5):
    """Kutsuu fn():ää kunnes se palauttaa muuta kuin None (videoiden käsittely palveluissa)."""
    end = time.time() + timeout
    while time.time() < end:
        v = fn()
        if v is not None:
            return v
        time.sleep(every)
    raise SystemExit(f'{what}: aikakatkaisu ({timeout} s)')


def mb(path):
    return f'{path.stat().st_size / 2**20:.0f} MB'


# ── OAuth (YouTube, LinkedIn) ───────────────────────────────────────────────

def oauth_browser(auth_url, params):
    state = secrets.token_urlsafe(16)
    params = {**params, 'state': state, 'redirect_uri': REDIRECT, 'response_type': 'code'}
    result = {}

    class H(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            result.update({k: v[0] for k, v in q.items()})
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.end_headers()
            self.wfile.write('<h2>Valmis — voit sulkea välilehden.</h2>'.encode())

        def log_message(self, *a):
            pass

    url = auth_url + '?' + urllib.parse.urlencode(params)
    log(f'Avaa selaimessa (avautuu automaattisesti):\n{url}')
    webbrowser.open(url)
    srv = http.server.HTTPServer(('localhost', REDIRECT_PORT), H)
    while 'code' not in result and 'error' not in result:
        srv.handle_request()
    if result.get('state') != state or 'code' not in result:
        raise SystemExit(f'OAuth epäonnistui: {result}')
    return result['code']


def auth_youtube():
    code = oauth_browser('https://accounts.google.com/o/oauth2/v2/auth', {
        'client_id': env('YOUTUBE_CLIENT_ID'),
        'scope': 'https://www.googleapis.com/auth/youtube',
        'access_type': 'offline', 'prompt': 'consent'})
    r = check(requests.post('https://oauth2.googleapis.com/token', data={
        'code': code, 'client_id': env('YOUTUBE_CLIENT_ID'),
        'client_secret': env('YOUTUBE_CLIENT_SECRET'),
        'redirect_uri': REDIRECT, 'grant_type': 'authorization_code'}), 'YouTube token')
    t = tokens()
    t['youtube'] = r.json()
    save_tokens(t)
    log('YouTube-kirjautuminen tallennettu.')


def youtube_token():
    t = tokens().get('youtube')
    if not t or 'refresh_token' not in t:
        raise SystemExit('YouTube: aja ensin  kaikuja-publish auth youtube')
    r = check(requests.post('https://oauth2.googleapis.com/token', data={
        'client_id': env('YOUTUBE_CLIENT_ID'), 'client_secret': env('YOUTUBE_CLIENT_SECRET'),
        'refresh_token': t['refresh_token'], 'grant_type': 'refresh_token'}), 'YouTube token refresh')
    return r.json()['access_token']


def auth_linkedin():
    code = oauth_browser('https://www.linkedin.com/oauth/v2/authorization', {
        'client_id': env('LINKEDIN_CLIENT_ID'), 'scope': 'openid profile w_member_social'})
    r = check(requests.post('https://www.linkedin.com/oauth/v2/accessToken', data={
        'grant_type': 'authorization_code', 'code': code, 'redirect_uri': REDIRECT,
        'client_id': env('LINKEDIN_CLIENT_ID'),
        'client_secret': env('LINKEDIN_CLIENT_SECRET')}), 'LinkedIn token')
    tok = r.json()
    me = check(requests.get('https://api.linkedin.com/v2/userinfo',
                            headers={'Authorization': f'Bearer {tok["access_token"]}'}), 'LinkedIn userinfo').json()
    tok['person_urn'] = f'urn:li:person:{me["sub"]}'
    tok['expires_at'] = int(time.time()) + int(tok.get('expires_in', 0))
    t = tokens()
    t['linkedin'] = tok
    save_tokens(t)
    log(f'LinkedIn-kirjautuminen tallennettu ({me.get("name")}), voimassa '
        f'{datetime.fromtimestamp(tok["expires_at"]).date()} asti.')


def linkedin_token():
    t = tokens().get('linkedin')
    if not t:
        raise SystemExit('LinkedIn: aja ensin  kaikuja-publish auth linkedin')
    if t.get('expires_at', 0) < time.time() + 3600:
        raise SystemExit('LinkedIn-token vanhentunut — aja  kaikuja-publish auth linkedin')
    return t


def threads_token():
    """Threads-token (60 pv) uusitaan viikon välein; uusittu token tallentuu tokens.json:iin.
    Jos THREADS_TOKEN vaihtuu .env:ssä, käytetään uutta."""
    src = env('THREADS_TOKEN')
    t = tokens().get('threads')
    if not t or t.get('env') != src:
        t = {'access_token': src, 'env': src, 'refreshed': 0}
    if not DRY and time.time() - t['refreshed'] > 7 * 86400:
        # onnistuu vasta kun token on yli vuorokauden vanha — epäonnistuminen ei haittaa
        r = requests.get('https://graph.threads.net/refresh_access_token', params={
            'grant_type': 'th_refresh_token', 'access_token': t['access_token']})
        if r.ok:
            t.update(access_token=r.json()['access_token'], refreshed=time.time(),
                     expires_at=time.time() + r.json().get('expires_in', 0))
            all_t = tokens()
            all_t['threads'] = t
            save_tokens(all_t)
    return t['access_token']


# ── Podbean ─────────────────────────────────────────────────────────────────

PB = 'https://api.podbean.com/v1'


def podbean_token():
    r = check(requests.post(f'{PB}/oauth/token', data={'grant_type': 'client_credentials'},
                            auth=(env('PODBEAN_CLIENT_ID'), env('PODBEAN_CLIENT_SECRET'))), 'Podbean token')
    return r.json()['access_token']


def podbean_upload(tok, path, ctype):
    r = check(requests.get(f'{PB}/files/uploadAuthorize', params={
        'access_token': tok, 'filename': path.name, 'filesize': path.stat().st_size,
        'content_type': ctype}), 'Podbean uploadAuthorize').json()
    with open(path, 'rb') as f:
        check(requests.put(r['presigned_url'], data=f, headers={'Content-Type': ctype}), f'Podbean upload {path.name}')
    return r['file_key']


def podbean_prepare(doc):
    if doc.get('podbean_id'):
        log(f'Podbean: luonnos on jo olemassa ({doc.get("podbean_url")})')
        return
    mp3, thumb = doc.file('mp3'), doc.file('kansikuva')
    title, content = doc.section('podbean-otsikko'), doc.section('podbean-kuvaus')
    if DRY:
        log(f'  [dry-run] Podbean: lataisi {mp3.name} ({mp3.stat().st_size >> 20} MB) ja '
            f'loisi luonnoksen "{title}"')
        return
    tok = podbean_token()
    log(f'Podbean: ladataan {mp3.name}…')
    media_key = podbean_upload(tok, mp3, 'audio/mpeg')
    logo_key = podbean_upload(tok, thumb, 'image/jpeg')
    r = check(requests.post(f'{PB}/episodes', data={
        'access_token': tok, 'title': title, 'content': text_to_html(content),
        'status': 'draft', 'type': 'public', 'media_key': media_key, 'logo_key': logo_key}),
        'Podbean episode').json()['episode']
    doc.set('podbean_id', r['id'])
    doc.set('podbean_url', r.get('permalink_url', ''))
    doc.set('podbean_player', r.get('player_url', ''))
    log(f'Podbean: luonnos tehty ({r.get("permalink_url")})')


def podbean_publish(doc):
    if doc.get('podbean_julkaistu'):
        log('Podbean: jo julkaistu')
        return
    if DRY:
        log('  [dry-run] Podbean: julkaisisi jakson')
        return
    tok = podbean_token()
    r = check(requests.post(f'{PB}/episodes/{doc.get("podbean_id")}', data={
        'access_token': tok, 'status': 'publish', 'type': 'public',
        'title': doc.section('podbean-otsikko'),
        'content': text_to_html(doc.section('podbean-kuvaus'))}), 'Podbean publish').json()['episode']
    doc.set('podbean_url', r.get('permalink_url', doc.get('podbean_url')))
    doc.set('podbean_player', r.get('player_url', doc.get('podbean_player')))
    doc.set('podbean_julkaistu', today())
    log(f'Podbean: julkaistu {r.get("permalink_url")}')


# ── WordPress ───────────────────────────────────────────────────────────────

def wp(method, path, **kw):
    base = env('WP_URL').rstrip('/')
    auth = (env('WP_USER'), env('WP_APP_PASSWORD'))
    return requests.request(method, f'{base}/wp-json/wp/v2/{path}', auth=auth, timeout=120, **kw)


def text_to_html(text):
    """Kappaleet <p>, rivinvaihdot <br>, URLit linkeiksi."""
    def link(m):
        u = m.group(0)
        return f'<a href="{u}" target="_blank" rel="noreferrer noopener">{u}</a>'
    out = []
    for para in re.split(r'\n\s*\n', text.strip()):
        para = para.replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;')
        para = re.sub(r'https?://[^\s<]+', link, para)
        out.append('<p>' + para.replace('\n', '<br>') + '</p>')
    return '\n\n'.join(out)


def wp_tag_ids(names):
    ids = []
    for n in [x.strip() for x in names.split(',') if x.strip()]:
        found = check(wp('GET', 'tags', params={'search': n, 'per_page': 100}), 'WP tags').json()
        match = [t for t in found if t['name'].lower() == n.lower()]
        if match:
            ids.append(match[0]['id'])
        else:
            ids.append(check(wp('POST', 'tags', json={'name': n}), f'WP tag {n}').json()['id'])
    return ids


def wp_body(doc):
    player = doc.get('podbean_player')
    html = ''
    if player:
        html += (f'<iframe title="{doc.section("podbean-otsikko")}" allowtransparency="true" height="150" '
                 f'width="100%" style="border: none; min-width: min(100%, 430px);height:150px;" '
                 f'scrolling="no" data-name="pb-iframe-player" src="{player}" loading="lazy"></iframe>\n\n')
    html += text_to_html(doc.fill(doc.section('blogi-teksti')))
    return html


def wordpress_prepare(doc):
    title = doc.section('blogi-otsikko')
    if DRY:
        log(f'  [dry-run] WordPress: luonnos "{title}", tagit: {doc.section("blogi-tagit")}, '
            f'kategoria {env("WP_CATEGORY_ID", False) or 15}')
        return
    data = {'title': title, 'content': wp_body(doc), 'status': 'draft',
            'categories': [int(env('WP_CATEGORY_ID', False) or 15)],
            'tags': wp_tag_ids(doc.section('blogi-tagit'))}
    if not doc.get('wp_media_id'):
        img = doc.file('kansikuva')
        m = check(wp('POST', 'media', data=img.read_bytes(), headers={
            'Content-Disposition': f'attachment; filename="{img.name}"',
            'Content-Type': 'image/jpeg'}), 'WP media').json()
        doc.set('wp_media_id', m['id'])
    data['featured_media'] = int(doc.get('wp_media_id'))
    if doc.get('wp_id'):
        r = check(wp('POST', f'posts/{doc.get("wp_id")}', json=data), 'WP update').json()
        log('WordPress: luonnos päivitetty')
    else:
        r = check(wp('POST', 'posts', json=data), 'WP create').json()
        doc.set('wp_id', r['id'])
        log('WordPress: luonnos tehty')
    log(f'  esikatselu: {env("WP_URL").rstrip("/")}/?p={r["id"]}&preview=true')


def wordpress_publish(doc):
    if doc.get('wp_julkaistu'):
        log(f'WordPress: jo julkaistu ({doc.get("wp_url")})')
        return
    if DRY:
        log('  [dry-run] WordPress: päivittäisi ja julkaisisi postauksen')
        return
    r = check(wp('POST', f'posts/{doc.get("wp_id")}', json={
        'status': 'publish', 'content': wp_body(doc), 'title': doc.section('blogi-otsikko')}), 'WP publish').json()
    doc.set('wp_url', r['link'])
    doc.set('wp_julkaistu', today())
    log(f'WordPress: julkaistu {r["link"]}')


# ── YouTube ─────────────────────────────────────────────────────────────────

YT = 'https://www.googleapis.com/youtube/v3'


def yt_find_latest(tok):
    h = {'Authorization': f'Bearer {tok}'}
    ch = check(requests.get(f'{YT}/channels', params={'part': 'contentDetails', 'mine': 'true'}, headers=h),
               'YouTube channels').json()
    uploads = ch['items'][0]['contentDetails']['relatedPlaylists']['uploads']
    items = check(requests.get(f'{YT}/playlistItems', params={
        'part': 'snippet,status', 'playlistId': uploads, 'maxResults': 5}, headers=h), 'YouTube playlistItems').json()
    return [(i['snippet']['resourceId']['videoId'], i['snippet']['title'],
             i['status']['privacyStatus'], i['snippet']['publishedAt']) for i in items['items']]


def yt_upload(tok, path, title, desc, tags, privacy):
    """videos.insert (resumable). Auditoimattoman sovelluksen lataukset lukittuvat yksityisiksi."""
    ctype = mimetypes.guess_type(path.name)[0] or 'video/mp4'
    r = check(requests.post('https://www.googleapis.com/upload/youtube/v3/videos',
                            params={'uploadType': 'resumable', 'part': 'snippet,status'},
                            headers={'Authorization': f'Bearer {tok}', 'X-Upload-Content-Type': ctype,
                                     'X-Upload-Content-Length': str(path.stat().st_size)},
                            json={'snippet': {'title': title, 'description': desc, 'tags': tags,
                                              'categoryId': env('YOUTUBE_CATEGORY_ID', False) or '27',
                                              'defaultLanguage': 'fi', 'defaultAudioLanguage': 'fi'},
                                  'status': {'privacyStatus': privacy, 'selfDeclaredMadeForKids': False}}),
              'YouTube upload init')
    log(f'YouTube: ladataan {path.name} ({mb(path)})…')
    with open(path, 'rb') as f:
        v = check(requests.put(r.headers['Location'], data=f,
                               headers={'Authorization': f'Bearer {tok}', 'Content-Type': ctype}),
                  'YouTube upload').json()
    return v['id']


def youtube_prepare(doc):
    title, desc = doc.section('youtube-otsikko'), doc.fill(doc.section('youtube-kuvaus'), strict=False)
    tags = [t.strip() for t in doc.section('youtube-tagit', False).split(',') if t.strip()]
    if len(title) > 100:
        raise SystemExit(f'YouTube-otsikko liian pitkä ({len(title)} > 100)')
    upload = env('YOUTUBE_UPLOAD', False) and not doc.get('youtube_id')
    if DRY:
        how = f'lataisi {doc.get("video")} yksityisenä ja ' if upload else ''
        log(f'  [dry-run] YouTube: {how}asettaisi otsikon "{title}", kuvauksen ({len(desc)} merkkiä), '
            f'{len(tags)} tagia' + (f' ja thumbnailin {doc.get("kansikuva")}' if doc.get('kansikuva') else ''))
        if upload or not tokens().get('youtube'):
            return
    tok = youtube_token()
    h = {'Authorization': f'Bearer {tok}'}
    vid = doc.get('youtube_id')
    if upload:
        vid = yt_upload(tok, doc.file('video'), title, desc, tags, 'private')
        doc.set('youtube_id', vid)
        doc.set('youtube_url', f'https://youtu.be/{vid}')
    elif not vid:
        latest = yt_find_latest(tok)
        log('YouTube: kanavan viimeisimmät lataukset:')
        for v in latest:
            log(f'  {v[0]}  {v[2]:8}  {v[3][:10]}  {v[1]}')
        cand = [v for v in latest if v[2] != 'public']
        if not cand:
            raise SystemExit('YouTube: ei yksityistä/listaamatonta latausta — lataa video ensin Studiossa '
                             '(yksityisenä) tai aseta youtube_id Julkaisu.md:hen')
        vid = cand[0][0]
        log(f'YouTube: valittu {vid} ("{cand[0][1]}")')
        if DRY:
            return
        doc.set('youtube_id', vid)
        doc.set('youtube_url', f'https://youtu.be/{vid}')
    if DRY:
        return
    check(requests.put(f'{YT}/videos', params={'part': 'snippet'}, headers=h, json={
        'id': vid, 'snippet': {'title': title, 'description': desc, 'tags': tags,
                               'categoryId': env('YOUTUBE_CATEGORY_ID', False) or '27',
                               'defaultLanguage': 'fi', 'defaultAudioLanguage': 'fi'}}), 'YouTube update')
    if doc.get('kansikuva'):
        thumb = doc.file('kansikuva')
        check(requests.post('https://www.googleapis.com/upload/youtube/v3/thumbnails/set',
                            params={'videoId': vid, 'uploadType': 'media'},
                            headers={**h, 'Content-Type': 'image/jpeg'}, data=thumb.read_bytes()),
              'YouTube thumbnail')
    log(f'YouTube: metatiedot asetettu (https://studio.youtube.com/video/{vid}/edit)')


