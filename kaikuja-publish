def li_escape(text):
    return re.sub(r'([\\|{}@\[\]()<>#*_~])', r'\\\1', text)


LI = 'https://api.linkedin.com/rest'


def linkedin_video(t, h, path):
    """Videos API: initializeUpload → osat PUTilla → finalizeUpload → odotus kunnes AVAILABLE."""
    init = check(requests.post(f'{LI}/videos', params={'action': 'initializeUpload'}, headers=h, json={
        'initializeUploadRequest': {'owner': t['person_urn'], 'fileSizeBytes': path.stat().st_size,
                                    'uploadCaptions': False, 'uploadThumbnail': False}}),
        'LinkedIn video init').json()['value']
    log(f'LinkedIn: ladataan {path.name} ({mb(path)})…')
    etags = []
    with open(path, 'rb') as f:
        for part in init['uploadInstructions']:
            f.seek(part['firstByte'])
            chunk = f.read(part['lastByte'] - part['firstByte'] + 1)
            r = check(requests.put(part['uploadUrl'], data=chunk,
                                   headers={'Content-Type': 'application/octet-stream'}), 'LinkedIn video part')
            etags.append(r.headers['etag'])
    check(requests.post(f'{LI}/videos', params={'action': 'finalizeUpload'}, headers=h, json={
        'finalizeUploadRequest': {'video': init['video'], 'uploadToken': init.get('uploadToken', ''),
                                  'uploadedPartIds': etags}}), 'LinkedIn video finalize')

    def ready():
        st = check(requests.get(f'{LI}/videos/{urllib.parse.quote(init["video"])}', headers=h),
                   'LinkedIn video status').json().get('status')
        if st == 'PROCESSING_FAILED':
            raise SystemExit('LinkedIn-videon käsittely epäonnistui')
        return True if st == 'AVAILABLE' else None
    poll(ready, 'LinkedIn-videon käsittely', every=10)
    return init['video']


