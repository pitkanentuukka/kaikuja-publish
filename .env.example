# kaikuja-publish credentials — copy to ~/bin/.env (or set KAIKUJA_PUBLISH_ENV) and chmod 600.
# Leave out the channels you don't use; `kaikuja-publish check` shows what is configured.

# YouTube (Google Cloud OAuth client, type "Desktop app")
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_UPLOAD=1
#YOUTUBE_CATEGORY_ID=27

# Podbean
PODBEAN_CLIENT_ID=
PODBEAN_CLIENT_SECRET=

# WordPress (application password)
WP_URL=https://www.example.com
WP_USER=
WP_APP_PASSWORD=
#WP_CATEGORY_ID=

# Mastodon
MASTODON_URL=https://mastodon.social
MASTODON_TOKEN=

# Bluesky (app password)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Facebook page + Instagram (page token) and Threads
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
THREADS_USER_ID=
THREADS_TOKEN=

# Website repository (sivusto step); default ~/src/kaikuja-website
#KAIKUJA_WEBSITE_DIR=
